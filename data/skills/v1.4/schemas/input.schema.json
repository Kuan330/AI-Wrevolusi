{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillInferenceTaskInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_title",
    "task_description",
    "occupation",
    "language",
    "country"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9_-]+$"
    },
    "task_title": {
      "type": "string",
      "minLength": 1
    },
    "task_description": {
      "type": "string",
      "minLength": 1
    },
    "occupation": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ms",
        "mixed",
        "local"
      ]
    },
    "country": {
      "type": "string",
      "const": "MY"
    }
  }
}
