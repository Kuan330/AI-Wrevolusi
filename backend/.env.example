APP_NAME=AI-Wrevolusi API
API_VERSION=v1
DEBUG=true
SQL_ECHO=false
AUTO_CREATE_TABLES=false
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<database>?sslmode=require
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ACCESS_COOKIE_NAME=aiw_access_token
REFRESH_COOKIE_NAME=aiw_refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SKILL_DATA_DIR=../data/skills/v1.4
SKILL_LLM_API_KEY=
SKILL_LLM_BASE_URL=https://openrouter.ai/api/v1
SKILL_LLM_MODEL=minimax/minimax-m3:free
SKILL_LLM_APP_URL=http://localhost:5173
SKILL_LLM_APP_NAME=AI-Wrevolusi
SKILL_PROMPT_VERSION=skill-inference-prompt-v1
SKILL_REQUEST_TIMEOUT_S=60
SKILL_MAX_RETRIES=2
