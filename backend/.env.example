APP_NAME=AI-Wrevolusi API
API_VERSION=v1
DEBUG=true
SQL_ECHO=false
AUTO_CREATE_TABLES=true
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<database>?sslmode=require
JWT_SECRET_KEY=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ACCESS_COOKIE_NAME=aiw_access_token
REFRESH_COOKIE_NAME=aiw_refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used only after a user confirms their skill directions. Keep the real key in .env.
SKILL_LLM_BASE_URL=https://openrouter.ai/api/v1
SKILL_LLM_API_KEY=
SKILL_LLM_MODEL=openai/gpt-5-mini
SKILL_LLM_APP_NAME=AI-Wrevolusi
SKILL_LLM_APP_URL=http://localhost:5173
SKILL_REQUEST_TIMEOUT_S=60
SKILL_MAX_RETRIES=2
SKILL_PROMPT_VERSION=skill-directions-v1

# Optional AI provider for the candidate-constrained /ai/* endpoints.
# Priority: a configured key first; otherwise (or when it fails at runtime)
# calls fall back to the built-in OpenCode free relay. With a key absent,
# AI_FALLBACK_ENABLED=false and AI_KEYLESS unset, the deterministic local
# logic runs instead.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Wire protocol: chat_completions (default) or responses.
AI_API_MODE=chat_completions
# true = call the endpoint without any credential (anonymous free relays).
AI_KEYLESS=false
# Optional JSON object of extra request headers, e.g.
# {"Authorization": "", "x-opencode-session": "my-app"}
AI_EXTRA_HEADERS=
# Built-in fallback relay (defaults already point at the OpenCode Zen free tier).
AI_FALLBACK_ENABLED=true
AI_FALLBACK_BASE_URL=https://opencode.ai/zen/v1
AI_FALLBACK_MODEL=muse-spark-1.3-contributor-free
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_RPM_LIMIT=60
AI_CACHE_SIZE=128
